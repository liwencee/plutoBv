ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  RewriteCond %{HTTP_HOST} ^www\.plutobv\.co\.uk$ [NC]
  RewriteRule ^ https://plutobv.co.uk%{REQUEST_URI} [L,R=301]

  # ---- Extensionless URLs ----
  # /services/companionship-care  instead of
  # /services/companionship-care.html

  # 1. Send /page.html to /page, and /index.html to /, once and permanently,
  #    so there is a single canonical address per page rather than two that
  #    serve identical content. Matching on THE_REQUEST (the original request
  #    line) rather than the current URI is what keeps this from looping:
  #    the internal rewrite in step 3 never rewrites THE_REQUEST.
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^ / [R=301,L]

  RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]

  # 2. Serve /page from page.html when that file exists. Anything with no
  #    matching .html (assets, the PHP endpoints, genuinely missing pages)
  #    falls through untouched to the normal 404.
  #
  #    The test is %{REQUEST_FILENAME}.html rather than
  #    %{DOCUMENT_ROOT}/$1.html: the DOCUMENT_ROOT form does not resolve on
  #    LiteSpeed, which is what Hostinger runs, so the condition silently
  #    failed and every clean URL 404'd while the redirect above kept
  #    sending visitors to those URLs.
  #
  #    There is deliberately no !-d condition here. "services" is both
  #    services.html and a services/ directory; excluding directories would
  #    skip this rule for /services and let mod_dir bounce it to /services/
  #    instead of serving the page.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.*)$ $1.html [L]

  # 3. Serve /section from section/index.html directly, rather than letting
  #    mod_dir 301 to /section/ first. The services overview lives at
  #    services/index.html precisely because "services" is also a directory:
  #    when both services.html and services/ existed, mod_dir appended the
  #    trailing slash before rule 2 could serve the page, and /services 404'd.
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*[^/])$ $1/index.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; form-action 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'"
  Header always set Strict-Transport-Security "max-age=15552000; includeSubDomains"
</IfModule>

Options -Indexes

AddDefaultCharset utf-8

# ---- Compression ----
# Text compresses by roughly 70%. Images and fonts are already compressed
# (JPEG, WebP, woff2), so re-compressing them only burns CPU.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ---- Browser caching ----
# HTML is deliberately not cached, so content edits appear on the next visit
# rather than whenever a stale copy happens to expire.
#
# CSS and JS are requested with a ?v= query string that changes when they do,
# so a month is safe. Photos get a month as well: swapping one reuses the
# same filename (see README), and a year-long cache would leave visitors
# looking at the old picture. The font is versioned in its filename and
# never changes in place, so it gets a year.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                          "access plus 1 month"
  ExpiresByType text/html                 "access plus 0 seconds"
  ExpiresByType text/css                  "access plus 1 month"
  ExpiresByType application/javascript    "access plus 1 month"
  ExpiresByType image/jpeg                "access plus 1 month"
  ExpiresByType image/webp                "access plus 1 month"
  ExpiresByType image/svg+xml             "access plus 1 month"
  ExpiresByType font/woff2                "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(html|php)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.woff2$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# ---- Repository files must never be served ----
# Deploying by FTP means hand-picking which folders to upload. Deploying by
# Git means the WHOLE repository lands in public_html, including .git, the
# docs, the checker scripts and the README. That is fine as long as none of
# it is reachable over HTTP, which is what the rules below enforce.
#
# .git in a web root is the serious one: if it is readable, anyone can
# reconstruct the entire source history, and any credential ever committed
# comes with it.

# Block dotfiles and dot-directories (.git, .gitignore, .superpowers, .env).
# .well-known stays reachable so Let's Encrypt / SSL renewal keeps working.
RedirectMatch 404 (?i)^/\.(?!well-known)

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Project directories that exist for development, not for visitors.
  RewriteRule ^(docs|scripts|images|\.superpowers)(/|$) - [F,L]
</IfModule>

# Documentation and source files that carry no value to a visitor. README.md
# in particular describes the anti-spam design and backend paths.
<FilesMatch "(?i)\.(md|json|lock|log|yml|yaml|ini|sh|bak|dist|sql)$">
  Require all denied
</FilesMatch>

<FilesMatch "(?i)^(LICENSE|README|CHANGELOG|composer\.(json|lock)|package(-lock)?\.json)$">
  Require all denied
</FilesMatch>

# The PHP test harness is a development tool, not an endpoint.
<FilesMatch "(?i)\.test\.php$">
  Require all denied
</FilesMatch>
